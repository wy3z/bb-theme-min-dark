{
  "name": "Min Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1A1A1A",
    "editor.foreground": "#BBBBBB",
    "editorLineNumber.foreground": "#727272",
    "editorLineNumber.activeForeground": "#727272",
    "editor.selectionBackground": "#2A2A2A",
    "editor.lineHighlightBackground": "#202020",
    "editorIndentGuide.background1": "#2A2A2A",
    "editorIndentGuide.activeBackground1": "#727272",
    "diffEditor.insertedTextBackground": "#6C9C7730",
    "diffEditor.removedTextBackground": "#F9758330"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#C1C1C1" }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#888888" }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "identifier"
      ],
      "settings": { "foreground": "#C1C1C1" }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": { "foreground": "#F97583" }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.regexp",
        "entity.name.tag"
      ],
      "settings": { "foreground": "#FFAB70" }
    },
    {
      "scope": [
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": { "foreground": "#FFAB70" }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": { "foreground": "#F8F8F8" }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.language",
        "variable.other.constant"
      ],
      "settings": { "foreground": "#79B8FF" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#79B8FF" }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.object.property",
        "variable.other.object.property",
        "variable.other.property"
      ],
      "settings": { "foreground": "#79B8FF" }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": { "foreground": "#B392F1" }
    },
    {
      "scope": [
        "punctuation",
        "meta.delimiter"
      ],
      "settings": { "foreground": "#D1D1D1" }
    },
    {
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.typeparameters",
        "meta.brace.round"
      ],
      "settings": { "foreground": "#C1C1C1" }
    },
    {
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": { "foreground": "#D1D1D1" }
    },
    {
      "scope": [
        "meta.method.declaration storage.type"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.quote"
      ],
      "settings": { "foreground": "#E394DC" }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": { "foreground": "#F97583" }
    },
    {
      "scope": [
        "variable.css",
        "variable.argument.css"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "support.function.misc.css"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "constant.other.color.rgb-value.hex.css",
        "constant.other.color.rgb-value.hex.css punctuation.definition.constant.css"
      ],
      "settings": { "foreground": "#F8F8F8" }
    },
    {
      "scope": [
        "punctuation.section.property-list.begin.bracket.curly.css",
        "punctuation.section.property-list.end.bracket.curly.css"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.class.css punctuation.definition.entity.css",
        "entity.other.attribute-name.pseudo-class.css punctuation.definition.entity.css"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "meta.attribute-selector.css entity.other.attribute-name.css"
      ],
      "settings": { "foreground": "#FFAB70" }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name.css"
      ],
      "settings": { "foreground": "#79B8FF" }
    },
    {
      "scope": [
        "keyword.other.important.css"
      ],
      "settings": { "foreground": "#B392F0" }
    },
    {
      "scope": [
        "constant.numeric.css keyword.other.unit"
      ],
      "settings": { "foreground": "#F8F8F8" }
    },
    {
      "scope": [
        "punctuation.separator.key-value.css",
        "punctuation.separator.list.comma.css",
        "punctuation.terminator.rule.css"
      ],
      "settings": { "foreground": "#BBBBBB" }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": { "foreground": "#8FC07A" }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": { "foreground": "#FF7A84" }
    }
  ]
}
